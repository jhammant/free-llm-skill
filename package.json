{
  "name": "free-llm-skill",
  "version": "1.0.0",
  "description": "A local OpenAI-compatible proxy that safely pools hosted LLM free tiers",
  "type": "module",
  "bin": {
    "free-llm": "src/cli.mjs"
  },
  "exports": {
    ".": "./src/index.mjs",
    "./scheduler": "./src/scheduler.mjs"
  },
  "files": [
    "src",
    "skill",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test",
    "check:publishable": "! grep -rn '/Use[r]s/' --exclude-dir=.git --exclude-dir=node_modules --exclude='*.md' ."
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jhammant/free-llm-skill.git"
  },
  "bugs": "https://github.com/jhammant/free-llm-skill/issues",
  "homepage": "https://github.com/jhammant/free-llm-skill#readme",
  "keywords": [
    "llm",
    "openai-compatible",
    "proxy",
    "free-tier",
    "rate-limit",
    "scheduler",
    "skill"
  ],
  "engines": {
    "node": ">=18"
  },
  "license": "MIT"
}
